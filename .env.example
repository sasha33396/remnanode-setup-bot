TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_ALLOWED_USERS=<comma-separated-telegram-user-ids>

# Recommended multi-panel mode: copy config/panels.yml.example to
# config/panels.yml. The file references these token environment variables but
# never contains their values. Leave both panel settings empty to use the
# legacy single-panel variables below.
PANELS_CONFIG_FILE=/etc/remnanode-setup-bot/panels.yml

# Deprecated compatibility input for existing installations. Do not set this
# together with PANELS_CONFIG_FILE.
PANELS_JSON=

# These names match config/panels.yml.example. Add another set for every
# additional panel; the names may be changed as long as YAML matches them.
MAIN_REMNAWAVE_TOKEN=<main-remnawave-token>
MAIN_DNS_TOKEN=<main-dns-balancer-token>
MAIN_CF_TOKEN=<main-cloudflare-token>
SECOND_REMNAWAVE_TOKEN=<second-remnawave-token>
SECOND_CF_TOKEN=<second-cloudflare-token>

# Used only when PANELS_CONFIG_FILE and PANELS_JSON are both empty.
REMNAWAVE_URL=
REMNAWAVE_TOKEN=
DNS_BALANCER_URL=
DNS_BALANCER_TOKEN=
CF_API_TOKEN=

ACME_EMAIL=<certificate-contact-email>
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
CERTIFICATE_STORE_PATH=/var/lib/deployer/certificates

REMNA_API_IP=<remnanode-api-ip>
METRICS_IP=<metrics-ip>

POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=<postgres-database>
DATABASE_URL=<postgresql-connection-url-with-postgres-host>

DEPLOY_SSH_PRIVATE_KEY=<host-path-to-deployment-private-key>
XRAY_SNI_REPO_URL=https://github.com/sasha33396/sni-external.git
XRAY_SNI_REF=v0.1.0-external
HEALTH_PORT=<host-health-port>
HTTP_TIMEOUT=30s
SSH_CONNECT_TIMEOUT=20s
SSH_COMMAND_TIMEOUT=5m
NODE_CONNECT_TIMEOUT=5m
TELEGRAM_POLL_TIMEOUT=30s
TELEGRAM_SESSION_TTL=15m
CERTIFICATE_RENEW_BEFORE=720h
CERTIFICATE_RENEW_INTERVAL=12h
CERTIFICATE_ISSUE_TIMEOUT=10m
DNS_PROPAGATION_TIMEOUT=5m
DNS_PROPAGATION_INTERVAL=5s
MAX_CONCURRENT_DEPLOYMENTS=2
MAX_CERTIFICATE_DISTRIBUTIONS=4
